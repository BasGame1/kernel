# qemu config file for RISCV32

# arch
RISCV=1
ARM=0
X86=0
32BIT=1

# emulator & debug flags
QEMU=1
DEBUG=0
NOSHELL=0

# filesystem
USE_EXT2=1
USE_DEFAULT_EXT2=1

# embedded
EMBEDDED=0

# drivers
USE_DEFAULT_RISCV_SCREEN=1
USE_DEFAULT_KEYBOARD=1

# dtb
DTB=0

# multiboot
USE_MULTIBOOT=0

# loadable modules
USE_LOAD_MODULES=0

# antartica
USE_ANTARTICA=0
USE_LINUX_ABI=0

# windows vm
USE_WINDOWS_SUPPORT=0

# ntar
USE_NTAR=0

# ram
PROBE_RAM=0
HARDCODED_RAM_VALUE=128M

# ab updates
USE_AB=0
USE_AB_NO_REBOOT=0

# security
VERIFY_PKCALL=0
USE_SID_PROTECTION=1
DISABLE_GID810_PKCALL=1
RANDOM_SEED=1
GENERATE_CERT=0
VERIFY_UPDATE=0
